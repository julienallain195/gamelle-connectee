# ============================================
#  CONFIGURATION DU RASPBERRY PI
# ============================================

firebase:
  credentials_file: "service-account.json"  # Clé privée Firebase (téléchargée depuis la console)
  project_id: "TON_PROJECT_ID"              # ex: gamelle-connectee-xxxxx
  storage_bucket: "TON_PROJECT_ID.appspot.com"

camera:
  width: 1280
  height: 720
  check_interval_seconds: 60    # Mesure toutes les 60 secondes (les photos ne sont
                                # envoyées QUE si la gamelle change d'état ou si le chat passe)
  empty_threshold: 35           # Score en dessous duquel la gamelle est "vide"
  # Zone de la gamelle dans l'image : x, y, largeur, hauteur (fractions 0 → 1).
  # À calibrer : lance `python calibrate.py` et ajuste jusqu'à ce que le cadre
  # vert englobe exactement l'intérieur de la gamelle.
  roi: [0.25, 0.35, 0.5, 0.4]

detection:
  cat_model: "models/detect.tflite"  # Modèle TFLite détection chat (voir README)
  cat_confidence: 0.5                 # Seuil de confiance (0.5 = raisonnable)
  cat_cooldown_minutes: 10            # Anti-spam : 1 photo/vidéo max toutes les 10 min si le chat reste devant

video:
  clip_seconds: 6            # Durée de la vidéo enregistrée quand le chat est détecté

notifications:
  expo_push_token: "ExponentPushToken[xxxx]"  # Token de ton téléphone (récupéré dans l'app)
  alert_cooldown_minutes: 30    # Anti-spam : max 1 alerte toutes les 30 min
  confirm_empty_checks: 2      # Alertes seulement après 2 relevés "vide" consécutifs

device:
  id: "raspberry-pi-1"          # Nom unique de ce Raspberry dans Firebase