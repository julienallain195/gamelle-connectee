# ⚙️ Service systemd : démarrage automatique de la surveillance
# Installation :
#   cp gamelle.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gamelle
# Commandes utiles :
#   systemctl status gamelle        → état du service
#   journalctl -u gamelle -f        → logs en direct
#   sudo systemctl restart gamelle  → redémarrage après modif de config

[Unit]
Description=Gamelle connectee - surveillance de la gamelle du chat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tampis
WorkingDirectory=/home/tampis/gamelle-connectee/raspberry-pi
ExecStart=/home/tampis/gamelle-connectee/raspberry-pi/venv/bin/python -u src/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
