rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Événements envoyés par le Raspberry
    match /events/{eventId} {
      allow read: if true;    // L'app mobile lit tout
      allow write: if false;  // Seul le Pi écrit (via compte de service)
    }
    // Tokens push des téléphones
    match /devices/{deviceId} {
      allow read: if true;
      allow write: if true;   // L'app écrit son propre token
    }
  }
}