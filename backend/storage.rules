rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{deviceId}/{fileName} {
      allow read: if true;    // L'app lit les photos
      allow write: if false;  // Seul le Pi upload (compte de service, qui ignore les règles)
    }
    // Clips vidéo enregistrés quand le chat est détecté
    match /videos/{deviceId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
